SMARTAI_DATABASE_HEAVY=OFF
SMARTAI_RUNTIME_ENVIRONMENT=development
SMARTAI_DATABASE_URL_LIGHT=sqlite:///data/smartai.db
SMARTAI_DATABASE_URL_HEAVY=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SMARTAI_DATABASE_AUTO_CREATE=true
# Optional: proxy used only by overseas model providers. Leave blank when the
# backend host can access them directly. When needed, set both to the full HTTP
# proxy URL shown by the proxy app (http://HOST:PORT); the port is not fixed.
# Zhipu/GLM always bypasses this proxy.
SMARTAI_HTTP_PROXY=
SMARTAI_HTTPS_PROXY=
# Process-wide safety ceiling shared by model configurations that point to the
# same endpoint. Per-model concurrency and RPM are configured in "Models &
# BYOK"; question preparation uses those same values as grading.
SMARTAI_MAX_CONCURRENT_LLM_PER_ENDPOINT=5
SMARTAI_STORAGE_ROOT=data/uploads
SMARTAI_STORAGE_BACKEND=local
# Optional for startup, required to save persisted BYOK keys. Generate a private
# random value (python -c "import secrets; print(secrets.token_hex(32))") and
# uncomment only in your untracked .env or deployment secret manager.
# SMARTAI_PROVIDER_ENCRYPTION_KEY=
# Development/test allow safe custom provider Base URLs by default for all
# implemented API protocols. Production stays off until application and
# deployment egress gates have been reviewed for the same release.
SMARTAI_CUSTOM_PROVIDER_ENDPOINTS_ENABLED=false
# Set SMARTAI_STORAGE_BACKEND=object in Render/free deployments and fill these secrets.
SMARTAI_STORAGE_S3_ENDPOINT=
SMARTAI_STORAGE_S3_BUCKET=
SMARTAI_STORAGE_S3_REGION=auto
SMARTAI_STORAGE_S3_ACCESS_KEY=
SMARTAI_STORAGE_S3_SECRET_KEY=

# Per-teacher task-original allocation (problem/submission files only).
# Knowledge-base documents are retained under a separate policy.
SMARTAI_UNFINISHED_SOURCE_QUOTA_BYTES=536870912
SMARTAI_SOURCE_STORAGE_RESERVATION_TTL_SECONDS=3600
SMARTAI_SOURCE_CLEANUP_RETRY_BASE_SECONDS=30
SMARTAI_SOURCE_CLEANUP_RETRY_MAX_SECONDS=3600

# Independent per-user allocation for personal, course, and task-scoped
# knowledge documents. Retained library content is never evicted for age;
# explicit/task-only cleanup remains charged until storage confirms deletion.
SMARTAI_KNOWLEDGE_STORAGE_QUOTA_BYTES=536870912
SMARTAI_KNOWLEDGE_STORAGE_RESERVATION_TTL_SECONDS=3600
SMARTAI_KNOWLEDGE_STORAGE_WRITER_LEASE_SECONDS=300
SMARTAI_KNOWLEDGE_STORAGE_WRITER_HEARTBEAT_SECONDS=30
SMARTAI_KNOWLEDGE_STORAGE_UNATTACHED_TTL_SECONDS=3600
SMARTAI_KNOWLEDGE_CLEANUP_RETRY_BASE_SECONDS=30
SMARTAI_KNOWLEDGE_CLEANUP_RETRY_MAX_SECONDS=3600
SMARTAI_KNOWLEDGE_CLEANUP_CLAIM_SECONDS=300
SMARTAI_KNOWLEDGE_CLEANUP_POLL_SECONDS=5
SMARTAI_KNOWLEDGE_CLEANUP_BATCH_SIZE=10
SMARTAI_KNOWLEDGE_ORPHAN_GUARD_RECHECK_SECONDS=300
SMARTAI_REQUIRE_AUTH=true
SMARTAI_ALLOW_DEMO_TOKENS=false
# Legacy anonymous registration is disabled; public signup uses email verification.
SMARTAI_REGISTRATION_CLOSED=true
# Set true only for local or controlled integration testing.
SMARTAI_SEED_TEST_USERS=false
SMARTAI_TEST_USERS_FILE=data/test_users.json
# Production must set a different private random value in its secret manager.
# SMARTAI_JWT_SECRET=
SMARTAI_REFRESH_COOKIE_SECURE=false
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Email verification registration (keep the password empty in templates).
SMARTAI_SMTP_HOST=smtp.gmail.com
SMARTAI_SMTP_PORT=587
SMARTAI_SMTP_SECURITY=starttls
SMARTAI_SMTP_USERNAME=smartai.univ@gmail.com
SMARTAI_SMTP_PASSWORD=
SMARTAI_MAIL_FROM_ADDRESS=smartai.univ@gmail.com
SMARTAI_MAIL_FROM_NAME=SmarTAI
SMARTAI_ALLOWED_EMAIL_DOMAINS=ustc.edu.cn
SMARTAI_PUBLIC_FRONTEND_URL=http://localhost:5173
SMARTAI_SMTP_TIMEOUT_SECONDS=10
SMARTAI_EMAIL_VERIFICATION_EXPIRY_SECONDS=1800
SMARTAI_EMAIL_VERIFICATION_RESEND_SECONDS=60
SMARTAI_EMAIL_VERIFICATION_HOURLY_EMAIL_LIMIT=5
SMARTAI_EMAIL_VERIFICATION_HOURLY_IP_LIMIT=20
